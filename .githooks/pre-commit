#!/bin/sh
# Pre-commit hook for the knowledge workspace.
# Stamps **Last updated:** on staged wiki articles and lints the KBs touched by
# this commit. Blocks the commit on lint errors (warnings pass).
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip once (not recommended): git commit --no-verify

root="$(git rev-parse --show-toplevel)"
lint="$root/bin/kb-lint"

if [ ! -x "$lint" ]; then
  exit 0
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found; skipping kb-lint" >&2
  exit 0
fi

python3 "$lint" --staged --quiet
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: kb-lint found errors in the KBs touched by this commit. Fix them, or run bin/kb-lint --fix <kb>." >&2
fi
exit $status
